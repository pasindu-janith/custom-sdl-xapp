{
    "name": "sdl-xapp",
    "version": "1.0.0",
    "containers": [
        {
            "name": "sdl-xapp",
            "image": {
                "registry": "127.0.0.1:5000",
                "name": "sdl-xapp",
                "tag": "1.0.0"
            }
        }
    ],
    "controls": {
        "logger": {
            "level": 3
        }
    },
    "messaging": {
        "ports": [
            {
                "name": "rmr-data",
                "container": "sdl-xapp",
                "port": 4560,
                "description": "rmr data port"
            },
            {
                "name": "rmr-route",
                "container": "sdl-xapp",
                "port": 4561,
                "description": "rmr route port"
            }
        ]
    },
    "rmr": {
        "protPort": "tcp:4560",
        "maxSize": 2072,
        "numWorkers": 1,
        "txMessages": ["RIC_SUB_REQ"],
        "rxMessages": ["RIC_SUB_RESP"]
    }
}
